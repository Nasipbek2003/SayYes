# =============================================================================
# Invitation Service — Environment Variables (example)
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public base URL used to build invitation links (e.g. https://sayyes.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_service?schema=public"

# -----------------------------------------------------------------------------
# Session / Auth secret (used for session cookies / JWT signing)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
SESSION_SECRET="change-me-in-production"

# -----------------------------------------------------------------------------
# Payment provider: "finik" — реальный эквайринг, "mock" — локальная заглушка
# (заглушка включает /mock-checkout и /api/invitations/:id/dev-activate)
# Цены заданы в коде: lib/pricing.ts — 100 сом разово, 300 сом подписка/месяц
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Finik Web SDK (https://www.finik.kg/documentation/web-sdk/)
#
#   1. node scripts/generate-finik-keys.mjs  → secrets/finik_{private,public}.pem
#   2. finik_public.pem загрузить в кабинете Finik («Ключи» → Веб-клиент)
#   3. выданный API-ключ → FINIK_API_KEY, id корпоративного счёта → FINIK_ACCOUNT_ID
#   4. публичный ключ Finik (проверка подписи вебхуков) → FINIK_WEBHOOK_PUBLIC_KEY
#
# Прод: https://api.acquiring.averspay.kg  |  Бета: https://beta.api.acquiring.averspay.kg
# Webhook URL:  <NEXT_PUBLIC_APP_URL>/api/payments/webhook
# Redirect URL: <NEXT_PUBLIC_APP_URL>/payment/callback
# -----------------------------------------------------------------------------
FINIK_BASE_URL="https://api.acquiring.averspay.kg"
# Путь создания платежа (входит в подпись). Docs: /v1/payment
FINIK_PAYMENT_PATH="/v1/payment"
FINIK_API_KEY=""
FINIK_ACCOUNT_ID=""
FINIK_QR_NAME="SayYes"
# Приватный ключ: либо одной строкой с \n, либо путь до файла
FINIK_PRIVATE_KEY=""
FINIK_PRIVATE_KEY_PATH="secrets/finik_private.pem"
# Публичный ключ Finik для проверки подписи вебхуков. Можно не задавать:
# по умолчанию берётся ключ среды из lib/payments/finikPublicKeys.ts
# (Finik публикует их в документации). Задай, если Finik сменит ключ.
FINIK_WEBHOOK_PUBLIC_KEY=""
FINIK_WEBHOOK_PUBLIC_KEY_PATH=""

# -----------------------------------------------------------------------------
# Telegram bot (placeholder — replace with real bot token)
# Obtain a token from @BotFather
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Bot username (without @) used to build t.me/<bot>?start=<code> deep-links
TELEGRAM_BOT_USERNAME=""

# -----------------------------------------------------------------------------
# Cron secret (protects /api/cron/* endpoints)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Upstash Redis (REST) — shared rate-limit store for serverless deploys.
# Optional: when unset, rate limiting falls back to per-process in-memory.
# Create a database at https://console.upstash.com and copy the REST creds.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Product analytics — optional PostHog forwarding of the conversion funnel.
# When unset, funnel events are still recorded via the structured logger.
# -----------------------------------------------------------------------------
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# -----------------------------------------------------------------------------
# Cloudinary image storage (author photos)
# Single connection string from the Cloudinary dashboard:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set the discrete CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY /
# CLOUDINARY_API_SECRET vars instead.
# -----------------------------------------------------------------------------
CLOUDINARY_URL=""
CLOUDINARY_UPLOAD_FOLDER="sayyes"

# -----------------------------------------------------------------------------
# S3-compatible object storage (legacy / optional — superseded by Cloudinary)
# -----------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="invitation-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
