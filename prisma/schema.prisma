generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Author {
  id             String           @id @default(cuid())
  email          String?          @unique
  /**
   * Короткий логин для входа без email (нужен служебным аккаунтам — админам).
   * Обычные авторы регистрируются по email и остаются без логина.
   */
  login          String?          @unique
  passwordHash   String?
  /** Роль: обычный пользователь или администратор панели `/admin`. */
  role           Role             @default(USER)
  telegramChatId String?          @unique
  createdAt      DateTime         @default(now())
  invitations    Invitation[]
  magicLinks     MagicLinkToken[]
  payments       Payment[]
  subscriptions  Subscription[]

  @@index([role])
}

/**
 * Настройки приложения в БД: секреты подписи сессий, пароли интеграций,
 * переключатели. Живут в базе, а не только в окружении, чтобы значение
 * переживало перезапуск и редеплой (иначе сгенерированный на старте секрет
 * менялся бы и все сессии разлогинивались).
 *
 * Значения с `isSecret = true` хранятся зашифрованными (AES-256-GCM) —
 * см. `lib/settings/store.ts`. В панель они наружу не отдаются, только маска.
 */
/**
 * Каталог стикеров и анимаций. Файлы лежат в Cloudinary, в базе — только
 * `publicId` и метаданные, из которых собирается ссылка с преобразованиями
 * (`f_auto,q_auto`, нужная ширина). Так набор стикеров меняется из админки без
 * деплоя, а тяжёлые файлы не едут в репозиторий.
 */
model Sticker {
  id        String      @id @default(cuid())
  /** Слаг категории каталога: bear, cat, … */
  category  String
  /** Подпись категории для UI (берётся первая непустая в категории). */
  label     String?
  /** Картинка или видеоклип: определяет и URL-путь Cloudinary, и тег в UI. */
  kind      StickerKind @default(IMAGE)
  /** Идентификатор файла в Cloudinary (без версии и расширения). */
  publicId  String      @unique
  format    String
  width     Int?
  height    Int?
  bytes     Int?
  /** Порядок в категории (по возрастанию). */
  sortOrder Int         @default(0)
  /** Скрыт из каталога, но файл сохранён. */
  hidden    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category, sortOrder])
  @@index([hidden])
}

enum StickerKind {
  IMAGE
  VIDEO
}

model Setting {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  authorId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  author     Author    @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model Invitation {
  id             String           @id @default(cuid())
  authorId       String
  templateId     String
  themeId        String
  tier           Tier             @default(BASIC)
  status         InvitationStatus @default(DRAFT)
  data           Json
  token          String?          @unique
  expiresAt      DateTime?
  oneTimeView    Boolean          @default(false)
  /** Telegram @username (normalised, без @) куда слать ответы гостей. */
  notifyTelegram String?
  createdAt      DateTime         @default(now())
  activatedAt    DateTime?
  author         Author           @relation(fields: [authorId], references: [id])
  opens          OpenEvent[]
  payments       Payment[]
  responses      Response[]
}

/**
 * Соответствие Telegram @username → chat.id, накапливается вебхуком при любом
 * сообщении боту. Нужно, потому что Bot API не умеет писать пользователю по
 * @username — только по числовому chat.id, который мы узнаём, когда человек
 * хотя бы раз написал боту (нажал Start).
 */
model TelegramContact {
  username  String   @id
  chatId    String
  updatedAt DateTime @updatedAt
}

model OpenEvent {
  id           String     @id @default(cuid())
  invitationId String
  openedAt     DateTime   @default(now())
  userAgent    String?
  invitation   Invitation @relation(fields: [invitationId], references: [id])
}

model Response {
  id           String     @id @default(cuid())
  invitationId String
  guestName    String?
  guestKey     String?
  outcome      Json
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id])

  @@unique([invitationId, guestKey])
}

model Payment {
  id           String        @id @default(cuid())
  /**
   * Приглашение, за которое платят. Может быть null: подписку автор может
   * оплатить и вне контекста конкретного приглашения.
   */
  invitationId String?
  authorId     String
  /** Разовая оплата приглашения или подписка на месяц. */
  plan         PaymentPlan   @default(SINGLE)
  provider     String
  sessionId    String        @unique
  /** Идентификатор транзакции у провайдера (для дедупликации вебхуков). */
  externalId   String?
  status       PaymentStatus @default(PENDING)
  /** Сумма в целых сомах (KGS). */
  amount       Int
  currency     String        @default("KGS")
  tier         Tier
  createdAt    DateTime      @default(now())
  paidAt       DateTime?
  author       Author        @relation(fields: [authorId], references: [id])
  invitation   Invitation?   @relation(fields: [invitationId], references: [id])

  @@index([invitationId])
  @@index([authorId])
}

/**
 * Месячная подписка автора: пока `expiresAt` в будущем, приглашения
 * публикуются без отдельной оплаты. Продление — новый успешный платёж плана
 * MONTHLY (Finik Web SDK не умеет автосписания, поэтому продление ручное).
 */
model Subscription {
  id        String   @id @default(cuid())
  authorId  String
  startedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Author   @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([expiresAt])
}

model NotificationOutbox {
  id           String       @id @default(cuid())
  authorId     String
  invitationId String
  type         String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  createdAt    DateTime     @default(now())
  sentAt       DateTime?
}

enum Tier {
  BASIC
  PREMIUM
}

enum InvitationStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentPlan {
  SINGLE
  MONTHLY
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}
